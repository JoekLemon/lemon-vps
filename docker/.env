# lemon-vps Environment Configuration
# Generated by lemon-vps installer

# ── General ──
DOMAIN={{DOMAIN}}
EMAIL={{EMAIL}}

# ── Admin ──
ADMIN_USER={{ADMIN_USER}}
ADMIN_PASS={{ADMIN_PASS}}

# ── System User ──
SYSTEM_USER={{SYSTEM_USER}}
SYSTEM_USER_HOME={{SYSTEM_USER_HOME}}
SYSTEM_USER_UID={{SYSTEM_USER_UID}}
SYSTEM_USER_GID={{SYSTEM_USER_GID}}

# ── Matrix Synapse ──
MATRIX_SERVER_NAME={{MATRIX_SERVER_NAME}}
MATRIX_SECRET_KEY={{MATRIX_SECRET_KEY}}

# ── WireGuard ──
WG_PRIVATE_KEY={{WG_PRIVATE_KEY}}
WG_PUBLIC_KEY={{WG_PUBLIC_KEY}}
WG_PRESHARED_KEY={{WG_PRESHARED_KEY}}

# ── Icecast ──
ICECAST_SOURCE_PASS={{ICECAST_SOURCE_PASS}}

# ── qBittorrent ──
QBIT_SAVE_PATH={{QBIT_SAVE_PATH}}

# ── NTFY.sh ──
NTFY_TOPIC={{NTFY_TOPIC}}
NTFY_TOKEN={{NTFY_TOKEN}}

# ── Forward Proxy ──
PROXY_AUTH={{PROXY_AUTH}}
PROXY_USER={{PROXY_USER}}
PROXY_PASS={{PROXY_PASS}}

# ── CrowdSec ──
CROWDSEC_CUSTOMER_ID={{CROWDSEC_CUSTOMER_ID}}
CROWDSEC_API_KEY={{CROWDSEC_API_KEY}}

# ── Docker Image Versions ──
CADDY_VERSION=latest
SYNAPSE_VERSION=latest
NEXTCLOUD_VERSION=latest
GITEA_VERSION=latest
GITEA_RUNNER_VERSION=latest
ICECAST_VERSION=latest
QBITTORRENT_VERSION=latest
NTFY_VERSION=latest

# ── Canarytokens ──
CANARYTG_VERSION=latest
CANARYTG_WG_KEY_SEED={{CANARYTG_WG_KEY_SEED}}
