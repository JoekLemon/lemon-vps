# CrowdSec Configuration
# Generated by lemon-vps

config:
  customer_id: "{{CROWDSEC_CUSTOMER_ID}}"
  console_api_key: "{{CROWDSEC_API_KEY}}"

db_config:
  type: sqlite
  db_path: /var/lib/crowdsec/data/crowdsec.db
  flush:
    interval: 30s

api:
  server:
    listen_uri: 127.0.0.1:8080

prometheus:
  enabled: false

log_level: info
